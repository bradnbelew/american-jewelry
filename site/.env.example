# Shopify (Headless sales channel → storefront). Leave unset and the bag stays a preview.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=shpat_private_storefront_token
# Optional: Admin API token with write_draft_orders, used only to invoice ring-builder designs.
SHOPIFY_ADMIN_TOKEN=

# Site
NEXT_PUBLIC_SITE_LIVE=false
